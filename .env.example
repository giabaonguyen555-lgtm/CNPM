# Local full-stack configuration. Copy to .env and replace secrets before sharing.
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/cnpm
ACCESS_TOKEN_SECRET=replace-with-one-persistent-secret
ADMIN_API_KEY=replace-with-one-admin-secret
CLIENT_ORIGIN=http://localhost:5173
PORT=8787
VITE_ACCESS_API_URL=http://localhost:8787
# This value is bundled into the browser; use only a demo key locally.
VITE_ADMIN_API_KEY=demo-admin-key
# Optional persistent local directories.
DATA_DIR=backend/data
UPLOADS_DIR=backend/uploads
# Public URL used in QR codes, if needed.
# VITE_PUBLIC_URL=https://your-tunnel-url.loca.lt
